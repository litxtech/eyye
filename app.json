{
  "expo": {
    "name": "eyye",
    "slug": "eyye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "eyye",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.litxtech.eyyeapp",
      "infoPlist": {
        "NSCameraUsageDescription": "EyyE uses camera for photos, videos and game evidence.",
        "NSPhotoLibraryUsageDescription": "EyyE uses photo library for media sharing.",
        "NSMicrophoneUsageDescription": "EyyE uses microphone for voice chat and messages.",
        "UIBackgroundModes": ["audio", "voip"]
      }
    },
    "android": {
      "package": "com.litxtech.eyyeapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1A120B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [{ "scheme": "eyye" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "icon": "./assets/android-icon-foreground.png", "color": "#F5A623" }],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-localization",
      "expo-image",
      "expo-web-browser",
      "expo-av",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60ccbe37-9d14-478f-928a-ebd2d0169fb4"
      }
    }
  }
}

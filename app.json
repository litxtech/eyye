{
  "expo": {
    "name": "eyye",
    "slug": "eyye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "eyye",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.litxtech.eyyeapp",
      "infoPlist": {
        "NSCameraUsageDescription": "EyyE uses camera for photos, videos and game evidence.",
        "NSPhotoLibraryUsageDescription": "EyyE uses photo library for media sharing.",
        "NSMicrophoneUsageDescription": "EyyE uses microphone for voice chat and messages.",
        "NSFaceIDUsageDescription": "EyyE uses Face ID to unlock the app.",
        "NSPhotoLibraryAddUsageDescription": "EyyE saves shared media to your photo library.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.litxtech.eyyeapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1A120B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "eyye"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#F5A623"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-localization",
      "expo-image",
      "expo-web-browser",
      "expo-av",
      "expo-font",
      "expo-sqlite",
      "expo-camera",
      [
        "expo-media-library",
        {
          "photosPermission": "EyyE uses your photo library to share media.",
          "savePhotosPermission": "EyyE saves shared media to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "EyyE uses Face ID to unlock the app."
        }
      ],
      "@config-plugins/react-native-webrtc",
      "@livekit/react-native-expo-plugin",
      "expo-updates"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60ccbe37-9d14-478f-928a-ebd2d0169fb4"
      }
    }
  }
}

{
  "expo": {
    "name": "eyye",
    "slug": "eyye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eyye.app",
      "infoPlist": {
        "NSCameraUsageDescription": "EyyE uses camera for photos and videos.",
        "NSPhotoLibraryUsageDescription": "EyyE uses photo library for media sharing.",
        "NSMicrophoneUsageDescription": "EyyE uses microphone for voice messages."
      }
    },
    "android": {
      "package": "com.eyye.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-apple-authentication",
      "expo-localization",
      "expo-image",
      "expo-web-browser",
      "expo-av",
      "expo-font"
    ],
    "scheme": "eyye"
  }
}
